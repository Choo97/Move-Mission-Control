# Java
JAVA_HOME=/c/Dev/java/jdk-17.0.7

# Server
SERVER_PORT=8081

# React frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8081

# Local status check (optional)
ADMIN_CHECK_USERNAME=
ADMIN_CHECK_PASSWORD=
ADMIN_CHECK_RESERVATION_ID=

# Upload
RESERVATION_PHOTO_UPLOAD_DIR=uploads/reservation-photos

# React development CORS
APP_CORS_ALLOWED_ORIGIN_VITE=http://localhost:5173
APP_CORS_ALLOWED_ORIGIN_CRA=http://localhost:3000

# Gmail SMTP
NOTIFICATION_EMAIL_ENABLED=true
NOTIFICATION_EMAIL_FROM=your-email@gmail.com
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# SMS
# 실제 비밀키는 .env.local에만 입력하고 Git에는 올리지 않습니다.
NOTIFICATION_SMS_ENABLED=false
SMS_PROVIDER=disabled
SMS_FROM=
SMS_ADMIN_TO=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SERVICE_ID=
