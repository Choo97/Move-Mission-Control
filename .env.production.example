# Spring profile
SPRING_PROFILES_ACTIVE=prod
# Cloud Run이 PORT를 자동으로 넣으므로 직접 설정하지 않습니다.

# Google Cloud deployment resources (not secrets)
GOOGLE_CLOUD_PROJECT=nalpo-504100
GOOGLE_CLOUD_REGION=asia-northeast3
CLOUD_SQL_INSTANCE=nalpo-504100:asia-northeast3:chanho-instance-mysql
GCS_BUCKET_NAME=chanho-bucket

# Cloud SQL for MySQL
SPRING_DATASOURCE_URL=jdbc:mysql:///movemission?cloudSqlInstance=nalpo-504100:asia-northeast3:chanho-instance-mysql&socketFactory=com.google.cloud.sql.mysql.SocketFactory&cloudSqlRefreshStrategy=lazy&ipTypes=PUBLIC&serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=nalpo_app
SPRING_DATASOURCE_PASSWORD=replace-with-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update
DB_MAX_POOL_SIZE=5
DB_MIN_IDLE=0
DB_CONNECTION_TIMEOUT_MS=30000
DB_IDLE_TIMEOUT_MS=600000
DB_MAX_LIFETIME_MS=1800000

# Frontend URL / CORS
APP_FRONTEND_BASE_URL=https://your-frontend-domain.example.com
APP_CORS_ALLOWED_ORIGIN_VITE=https://your-frontend-domain.example.com
APP_CORS_ALLOWED_ORIGIN_CRA=https://your-frontend-domain.example.com

# Privacy secrets
PRIVACY_CRYPTO_SECRET=replace-with-long-random-encryption-secret
PRIVACY_HASH_SECRET=replace-with-different-long-random-hash-secret

# Admin initial account
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-password
ADMIN_INITIAL_ROLE=ADMIN

# Reservation lookup protection
RESERVATION_LOOKUP_MAX_FAILURE_COUNT=5
RESERVATION_LOOKUP_FAILURE_WINDOW_MINUTES=10
RESERVATION_LOOKUP_LOCK_MINUTES=10
RESERVATION_LOOKUP_CLEANUP_DELAY_MINUTES=30

# Upload
# Cloud Run에서 chanho-bucket을 이 경로에 읽기/쓰기 볼륨으로 마운트합니다.
RESERVATION_PHOTO_UPLOAD_DIR=/app/uploads/reservation-photos
RESERVATION_PHOTO_MAX_FILE_SIZE_BYTES=10485760
RESERVATION_PHOTO_MAX_FILES_PER_REQUEST=5
RESERVATION_PHOTO_MAX_FILES_PER_RESERVATION=10

# Empty Cloud SQL only: enable for the first deployment, verify 12 rows, then disable.
DEMO_SEED_ENABLED=false

# Email notification: keep disabled for first demo deployment
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_SUBJECT_PREFIX=[Move Mission Control]
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# SMS notification: keep disabled until a provider account is ready
NOTIFICATION_SMS_ENABLED=false
SMS_PROVIDER=disabled
SMS_FROM=
SMS_ADMIN_TO=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SERVICE_ID=
