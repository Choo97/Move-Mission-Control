# Spring profile
SPRING_PROFILES_ACTIVE=prod
# Railway는 PORT를 자동으로 넣어줍니다. SERVER_PORT는 Railway가 아닌 환경에서만 사용합니다.
SERVER_PORT=8080

# Database
SPRING_DATASOURCE_URL=jdbc:mysql://your-db-host:3306/movemission?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
SPRING_DATASOURCE_USERNAME=your-db-user
SPRING_DATASOURCE_PASSWORD=replace-with-db-password
SPRING_JPA_HIBERNATE_DDL_AUTO=update

# Frontend URL / CORS
APP_FRONTEND_BASE_URL=https://your-frontend-domain.example.com
APP_CORS_ALLOWED_ORIGIN_VITE=https://your-frontend-domain.example.com
APP_CORS_ALLOWED_ORIGIN_CRA=https://your-frontend-domain.example.com

# Privacy secrets
PRIVACY_CRYPTO_SECRET=replace-with-long-random-encryption-secret
PRIVACY_HASH_SECRET=replace-with-different-long-random-hash-secret

# Admin initial account
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=replace-with-strong-admin-password
ADMIN_INITIAL_ROLE=ADMIN

# Reservation lookup protection
RESERVATION_LOOKUP_MAX_FAILURE_COUNT=5
RESERVATION_LOOKUP_FAILURE_WINDOW_MINUTES=10
RESERVATION_LOOKUP_LOCK_MINUTES=10
RESERVATION_LOOKUP_CLEANUP_DELAY_MINUTES=30

# Upload
RESERVATION_PHOTO_UPLOAD_DIR=/app/uploads/reservation-photos
RESERVATION_PHOTO_MAX_FILE_SIZE_BYTES=10485760
RESERVATION_PHOTO_MAX_FILES_PER_REQUEST=5
RESERVATION_PHOTO_MAX_FILES_PER_RESERVATION=10

# Email notification: keep disabled for first demo deployment
NOTIFICATION_EMAIL_ENABLED=false
NOTIFICATION_EMAIL_FROM=
NOTIFICATION_EMAIL_SUBJECT_PREFIX=[Move Mission Control]
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true

# SMS notification: keep disabled until a provider account is ready
NOTIFICATION_SMS_ENABLED=false
SMS_PROVIDER=disabled
SMS_FROM=
SMS_ADMIN_TO=
SMS_ACCESS_KEY=
SMS_SECRET_KEY=
SMS_SERVICE_ID=
